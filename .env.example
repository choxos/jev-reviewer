# Copy to .env (gitignored). Only server.js reads it; the key never reaches the browser.
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional
# PORT=8787
# Other sites allowed to use this relay, comma separated (the server on jevreviewer.xera.ac uses
# https://jevreviewer.xera.ac,https://choxos.github.io).
# ALLOWED_ORIGINS=
# Input tokens per UTC day the server's key may spend for visitors without their own key.
# 0 or unset: no limit. 10000000 is about $0.42 a day at $0.042 per million tokens.
# DAILY_TOKEN_BUDGET=0
